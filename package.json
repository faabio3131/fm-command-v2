{
  "name": "fm-control-center",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate --name=foundation",
    "db:migrate": "drizzle-kit migrate",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "test:runtime-smoke": "node scripts/runtime-smoke.mjs",
    "security:secrets": "node scripts/secret-scan.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.5",
    "better-auth": "1.7.5",
    "drizzle-orm": "0.45.2",
    "next": "16.3.8",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "drizzle-kit": "0.31.10",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.8",
    "typescript": "5.9.2",
    "vitest": "5.0.1",
    "@playwright/test": "^1.55.0"
  }
}

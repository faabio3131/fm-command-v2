NODE_ENV=development
DATABASE_URL=postgresql://fmcc:fmcc@localhost:5432/fmcc
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
RUN_MIGRATIONS_ON_STARTUP=false

# FMCC Product-Owned Cognitive Vertical Core
# Configure an OpenAI-compatible model endpoint at runtime. Never commit real secrets.
FMCC_COGNITIVE_MODEL_BASE_URL=https://api.openai.com
FMCC_COGNITIVE_MODEL_API_KEY=replace-with-runtime-secret
FMCC_COGNITIVE_MODEL_ID=replace-with-approved-model


# Cofre de credenciais dos conectores (chaves dos ERPs de cada empresa)
# 32 bytes aleatórios em base64, por exemplo: openssl rand -base64 32
# Guardar no gerenciador de segredos do ambiente. Nunca commitar valor real.
FMCC_CREDENTIAL_KEY=replace-with-base64-32-bytes

# Aplicativos OAuth do V2 junto aos ERPs (um por provedor; o cliente só autoriza).
# Cadastre o retorno https://<seu-dominio>/api/oauth/callback no painel do provedor.
# Opcional: FMCC_OAUTH_<PROVEDOR>_AUTHORIZE_URL e _TOKEN_URL (https) para trocar os endereços padrão.
FMCC_OAUTH_CONTA_AZUL_CLIENT_ID=replace-with-runtime-secret
FMCC_OAUTH_CONTA_AZUL_CLIENT_SECRET=replace-with-runtime-secret
FMCC_OAUTH_BLING_CLIENT_ID=replace-with-runtime-secret
FMCC_OAUTH_BLING_CLIENT_SECRET=replace-with-runtime-secret


# Avaliação proativa de alertas
# Segredo exclusivo do scheduler/cron. Nunca enviar ao navegador ou commitar valor real.
FMCC_ALERT_AUTOMATION_SCHEDULER_SECRET=replace-with-runtime-secret-at-least-32-chars


# Canais de envio (e-mail e WhatsApp). Os provedores reais são configurados por empresa em /dashboard/channels
# (a chave de cada empresa vai ao cofre, nunca a este arquivo).
# Provedor SIMULADO (só testes/homologação interna): FMCC_CHANNEL_SIMULATED=1. Em produção ele só liga com
# FMCC_CHANNEL_ALLOW_SIMULATED=1 também, para ninguém "enviar" mensagem de mentira por engano.
# FMCC_CHANNEL_SIMULATED=
# FMCC_CHANNEL_ALLOW_SIMULATED=

NODE_ENV=development
DATABASE_URL=postgresql://fmcc:fmcc@localhost:5432/fmcc
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
RUN_MIGRATIONS_ON_STARTUP=false

# FMCC Product-Owned Cognitive Vertical Core
# Configure an OpenAI-compatible model endpoint at runtime. Never commit real secrets.
FMCC_COGNITIVE_MODEL_BASE_URL=https://api.openai.com
FMCC_COGNITIVE_MODEL_API_KEY=replace-with-runtime-secret
FMCC_COGNITIVE_MODEL_ID=replace-with-approved-model


# Kordena — plano de controle comercial governado
# Tenant interno do FMCC autorizado a consumir a fonte comercial global do Kordena.
FMCC_KORDENA_CONTROL_TENANT_ID=replace-with-nova-fm-control-tenant-id
# Origens HTTPS permitidas, separadas por vírgula. Fora da allowlist = fail-closed.
FMCC_KORDENA_ALLOWED_ORIGINS=https://kordena-preview.example.com
# Segredo dedicado de runtime. A source deve referenciar exatamente:
# env:FMCC_KORDENA_CONTROL_PLANE_TOKEN
FMCC_KORDENA_CONTROL_PLANE_TOKEN=replace-with-runtime-secret


# Avaliação proativa de alertas
# Segredo exclusivo do scheduler/cron. Nunca enviar ao navegador ou commitar valor real.
FMCC_ALERT_AUTOMATION_SCHEDULER_SECRET=replace-with-runtime-secret-at-least-32-chars

# KF-03 — Kordena live runtime bootstrap (one-time, idempotent)
# Enable only during controlled registration/verification, then disable.
FMCC_KORDENA_RUNTIME_BOOTSTRAP=false
FMCC_KORDENA_RUNTIME_BOOTSTRAP_VERIFY=false
# Real HTTPS Kordena runtime base URL. Must be included in ALLOWED_ORIGINS.
FMCC_KORDENA_BASE_URL=https://kordena-preview.example.com

